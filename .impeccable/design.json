  "narrative": {
    "northStar": "The Baker's Formula Book",
    "overview": "A private notebook of formulas kept on a stone bench: travertine ground, a walnut spine across the top, bronze where your hand goes. The page is quiet so the numbers can be loud. Scaling is a sentence, not a form.",
    "keyCharacteristics": [
      "Light only, daylight kitchen.",
      "One serif voice for titles, sentences and quantities; one grotesk for UI; script for the mark only.",
      "Hairline rules instead of cards.",
      "Bronze marks interaction."
    ],
    "rules": [
      {
        "name": "The Earth-Only Rule",
        "body": "No saturated or neon hue enters the UI. A new state colour must be an earth tone and must carry meaning.",
        "section": "colors"
      },
      {
        "name": "The Bronze-Means-Touch Rule",
        "body": "Bronze appears where the visitor can act or has acted. It is never decoration.",
        "section": "colors"
      },
      {
        "name": "The Serif-For-Numbers Rule",
        "body": "Every weighed quantity is set in the display serif with lining tabular figures, right-aligned. Units are small grotesk in taupe.",
        "section": "typography"
      },
      {
        "name": "The Window-Light Rule",
        "body": "One soft daylight falloff, on one panel. No streaks, gloss, glass or glows anywhere.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every weighed quantity in Gilda Display with lining tabular figures, right-aligned.",
      "Do separate content with hairlines (#D6CABA) and space, not boxes.",
      "Do reserve bronze for interaction and rust/sage for meaning.",
      "Do keep tap targets at 44px or more and text contrast at 4.5:1 or more (taupe #6E5F53 is the floor for small text)."
    ],
    "donts": [
      "Don't reintroduce the neon world: no navy grounds, cyan outlines, hard offset shadows, checkerboards, starbursts or cartoon icons.",
      "Don't wrap content in cards or nest panels; the sentence panel and dialog are the only raised surfaces.",
      "Don't put a tracked-caps eyebrow above a heading.",
      "Don't use the script face for anything but the \"Hay's\" mark.",
      "Don't show AI photos of finished bakes; they would pass for Ben's own. Show ingredients and tools only."
    ]
  }
